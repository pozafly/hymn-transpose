{
  "name": "hymn-transpose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "score": "tsx score/build.ts",
    "prerender": "node --env-file-if-exists=.env scripts/prerender-library.ts",
    "test:e2e": "playwright test",
    "worker": "node --env-file-if-exists=.env lib/worker.ts",
    "import:hymns": "node scripts/import-hymns.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.5.1"
}
