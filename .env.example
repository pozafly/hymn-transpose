APP_PASSWORD=replace-with-a-long-private-password
# Set true when using HTTPS (Cloudflare Tunnel).
COOKIE_SECURE=false
# Increment after changing LilyPond, fonts, or render configuration; restart app and worker together.
SCORE_RENDER_VERSION=1
# Create a dedicated remotely managed Cloudflare Tunnel for LXC 204.
# Fill in the token in .env only. Never commit .env.
TUNNEL_TOKEN=
